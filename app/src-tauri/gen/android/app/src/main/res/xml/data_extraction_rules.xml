<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android 12 and later form of `backup_rules.xml`, which covers
    device-to-device transfer as well as cloud backup. Both need saying: a
    direct transfer to a new phone would otherwise clone the identity key
    without ever touching Google's servers. Issue #57.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
