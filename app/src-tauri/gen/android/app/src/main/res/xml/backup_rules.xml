<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing in this app's storage may leave the device.

    Auto Backup uploads an app's `files/` directory to the user's Google
    Drive, and on Android the node's private key lives there as a plain file
    rather than in the Android Keystore. Restoring a backup onto a second
    phone therefore produced two devices holding one identity and one roster
    membership: peers cannot tell them apart, and revoking one revokes both.

    Belt and braces with `android:allowBackup="false"` in the manifest. The
    flag alone is enough today; these rules mean that turning backup on later,
    for settings worth keeping, cannot re-export the key by accident. Issue
    #57.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
