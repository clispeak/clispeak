{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clispeak",
  "version": "0.1.0",
  "identifier": "org.clispeak.app",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run build:css",
    "beforeDevCommand": "npm run build:css"
  },
  "app": {
    "windows": [
      {
        "title": "clispeak",
        "width": 420,
        "height": 640,
        "label": "main",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "frameworks": [
        "SystemConfiguration",
        "AVFAudio"
      ]
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
