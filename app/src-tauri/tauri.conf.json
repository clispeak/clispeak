{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voicecast",
  "version": "0.1.0",
  "identifier": "com.voicecast.app",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run build:css",
    "beforeDevCommand": "npm run build:css"
  },
  "app": {
    "windows": [
      {
        "title": "voicecast",
        "width": 420,
        "height": 640,
        "label": "main",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}