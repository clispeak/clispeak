{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voicecast",
  "version": "0.1.0",
  "identifier": "com.voicecast.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "voicecast",
        "width": 420,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}