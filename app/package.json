{
  "name": "clispeak-ui",
  "private": true,
  "version": "0.1.0",
  "description": "The clispeak app's interface. Compiled CSS only \u2014 no bundler, no framework.",
  "scripts": {
    "tauri": "tauri",
    "build:css": "tailwindcss -i src/input.css -o src/styles.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o src/styles.css --watch",
    "test:ui": "node tests/harness.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "tailwindcss": "^4.3.3"
  }
}
